# Copy to .env, fill in the API key, and start the adapter with:
#   node --env-file=.env dist/cli.js
# Only the API key is required. Every other setting is commented out and shows its default;
# uncomment a line to change it. Values set here override ~/.cursor2openai/config.yaml.

# Required. At least 32 characters. Generate one with: openssl rand -hex 32
CURSOR2OPENAI_API_KEY=

# Listening address and port. A non-loopback address (for example 0.0.0.0) needs HTTPS,
# or CURSOR2OPENAI_ALLOW_INSECURE_HTTP=true.
# CURSOR2OPENAI_HOST=127.0.0.1
# CURSOR2OPENAI_PORT=8787

# HTTPS: set both files, or neither.
# CURSOR2OPENAI_TLS_CERT_FILE=/path/to/cert.pem
# CURSOR2OPENAI_TLS_KEY_FILE=/path/to/key.pem
# CURSOR2OPENAI_ALLOW_INSECURE_HTTP=false

# Folder agent runs in. Must be outside your home folder, owned by you, mode 0700.
# Default: macOS /Users/Shared/cursor2openai, Linux /var/lib/cursor2openai
# CURSOR2OPENAI_WORKSPACE_DIR=/var/lib/cursor2openai

# Conversation index, model cache, and optional config.yaml and model-filter.txt.
# CURSOR2OPENAI_DATA_DIR=~/.cursor2openai

# CURSOR2OPENAI_DEFAULT_MODEL=composer-2.5
# CURSOR2OPENAI_AGENT_BIN=agent
# CURSOR2OPENAI_REQUEST_TIMEOUT_MS=600000
# CURSOR2OPENAI_MAX_CONCURRENT=4
# CURSOR2OPENAI_MAX_QUEUED=16
# CURSOR2OPENAI_QUEUE_TIMEOUT_MS=60000
# CURSOR2OPENAI_CONVERSATION_TTL_DAYS=30
# CURSOR2OPENAI_MAX_CONVERSATIONS=10000
# CURSOR2OPENAI_MODEL_CACHE_MS=300000
# CURSOR2OPENAI_MAX_BODY_BYTES=20971520

# Logs raw Cursor CLI errors. They may contain prompt text.
# CURSOR2OPENAI_DEBUG_LOG_AGENT_OUTPUT=false

# Optional: a Cursor user API key instead of the saved `agent login`.
# CURSOR_API_KEY=
